# ---- App (safe to expose, used by the browser) ----
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Development copy (same project, separate tables) — leave empty for production ----
# VITE_DB_SCHEMA=dev
# VITE_STORAGE_BUCKET=photos-dev
# SUPABASE_DB_SCHEMA=dev
# STORAGE_BUCKET=photos-dev

# ---- Server-side only: scripts/rank.ts (NEVER put these in the app) ----
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
# Optional: lets `npm run migrate` apply supabase/schema.sql for you (supabase.com → Account → Access Tokens)
SUPABASE_ACCESS_TOKEN=
# Optional overrides
# RANK_MODEL=claude-opus-5
# RANK_CONCURRENCY=4
# Trends: the worker fetches reels with yt-dlp (python3 -m pip install --user yt-dlp curl_cffi).
# Instagram needs a logged-in session: YTDLP_BROWSER=brave (laptop) or YTDLP_COOKIES=/path/cookies.txt
# YTDLP_BROWSER=brave
# TRENDS_DOWNLOAD=0   # to disable fetching
