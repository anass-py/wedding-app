{
  "name": "wedding-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && vite build",
    "preview": "vite preview --host",
    "rank": "node --env-file-if-exists=.env --import tsx scripts/rank.ts",
    "rank:watch": "node --env-file-if-exists=.env --import tsx scripts/rank.ts --watch",
    "qr": "node --import tsx scripts/qr.ts",
    "icons": "python3 scripts/make_icons.py",
    "compare": "node scripts/compare.mjs",
    "transcode": "node --env-file-if-exists=.env --import tsx scripts/transcode.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "memories": "node --env-file-if-exists=.env --import tsx scripts/memories.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "dev:https": "VITE_HTTPS=1 vite --host",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "schema:dev": "node --import tsx scripts/schema-dev.ts",
    "guests": "node --env-file-if-exists=.env --import tsx scripts/guests.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "latest",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "zod": "^4.1.9"
  }
}
